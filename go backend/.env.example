# ── Ilova ──────────────────────────────────────────────
APP_ENV=local                  # local | production
APP_PORT=8090                  # 8080 boshqa loyiha bilan band — 8090 ishlatiladi
APP_NAME=ttysi_fit
CORS_ORIGINS=http://localhost:3000   # vergul bilan ajratilgan ruxsat etilgan originlar

# Kunlik faollik chegarasi qaysi mintaqada hisoblanadi (IANA nomi).
# UTC qoldirilsa O'zbekistonda (UTC+5) mahalliy 00:00–05:00 dagi qadamlar
# KECHAGI kunga yozilib, o'sha kun statistikasini buzadi.
APP_TIMEZONE=Asia/Tashkent

# ── Sertifikat imzo bloki ──────────────────────────────
# Muhr va imzo skani — institutning rasmiy hujjati, shuning uchun repozitoriyda
# EMAS, serverdagi faylda turadi. Yo'l bo'sh bo'lsa o'sha element chizilmaydi.
#
# MUHIM: PNG alfa kanalisiz bo'lishi shart — fpdf shaffof piksellarni qora
# qilib chizadi. Server startupda tekshiradi va yaroqsiz bo'lsa ishga tushmaydi.
#   convert muhr.png -background white -alpha remove -alpha off muhr-oq.png
CERT_STAMP_PATH=
CERT_SIGNATURE_PATH=
CERT_SIGNER_NAME=
CERT_SIGNER_TITLE=Rektor

# "NAMUNA" muhri — haqiqiy muhr o'rniga sinov belgisi (ochiq "haqiqiy muhr
# emas" yozuvi bilan). Default: faqat local'da yoqilgan; production'da
# yoqilsa server ishga tushmaydi (§17.1).
CERT_SAMPLE_STAMP=true

# ── PostgreSQL (lokal o'rnatilgan) ─────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ttysi_fit_dev
DB_SSLMODE=disable

# ── Redis (Docker) ─────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380                # docker-compose host porti (6379 band)
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT ────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ── HEMIS integratsiyasi (faqat asosiy URL + token) ────
HEMIS_BASE_URL=https://student.ttyesi.uz/rest/v1
HEMIS_TOKEN=                         # HEMIS API tokeni
# Qolgan sozlamalar kod default'lari (kerak bo'lsa override qiling):
# HEMIS_STRUCTURE_PATH=/data/structure-list
# HEMIS_FACULTY_TYPE_CODE=11
# HEMIS_PAGE_LIMIT=200
# HEMIS_RATE_LIMIT=10                 # sekundiga maksimal so'rov (HEMIS blokini oldini olish)

# ── Xavfsizlik (CLAUDE.md §17) ─────────────────────────
# Rate limiting: local'da default o'chirilgan, boshqa muhitlarda yoqilgan.
# Production'da RATE_LIMIT_ENABLED=false qo'yib bo'lmaydi (config validate).
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_GLOBAL_PER_MIN=120        # IP boshiga umumiy so'rov/daqiqa
# RATE_LIMIT_AUTH_PER_MIN=10           # IP boshiga /auth so'rov/daqiqa (brute-force)
# MAX_BODY_BYTES=1048576               # request body limiti (1MB, DoS himoyasi)
# SSRF allowlist — avatar faqat shu hostlardan yuklab olinadi:
# MEDIA_ALLOWED_HOSTS=student.ttyesi.uz,hemis.ttyesi.uz

# ── Bayroqlar ──────────────────────────────────────────
SEED_FAKE_DATA=true
ENABLE_SWAGGER=true
LOG_LEVEL=debug
MOCK_SMS=true
MOCK_EMAIL=true
