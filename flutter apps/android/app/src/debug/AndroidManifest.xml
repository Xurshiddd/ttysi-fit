<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- usesCleartextTraffic: dev backend TLS'siz (http://localhost:8090) ishlaydi.
         CLAUDE.md §17.2 — TLS yumshatilishi FAQAT local uchun. Shu sababli bu
         atribut debug manifestda turadi: release build'da qo'llanmaydi va
         Android 9+ cleartext'ni avtomatik bloklaydi (esdan chiqarib bo'lmaydi). -->
    <application
        android:name="${applicationName}"
        android:usesCleartextTraffic="true" />
</manifest>
